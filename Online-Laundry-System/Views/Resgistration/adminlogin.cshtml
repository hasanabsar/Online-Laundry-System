       @model Online_Laundry_System.Models.Admin


    <div class="container container-wrapper my-5">
        <div class="login-card shadow-lg rounded-4 overflow-hidden">
            <div class="row g-0">

                <!-- Left Side - Admin Info -->
                <div class="col-lg-6 bg-primary text-white p-5 d-flex flex-column justify-content-center">
                    <div class="login-left">
                        <h2 class="fw-bold mb-3 text-white">Admin Panel Access</h2>
                        <p class="mb-4">
                            Welcome back, Administrator. Sign in to manage users, monitor reports,
                            and control system settings securely.
                        </p>

                        <ul class="feature-list list-unstyled">
                            <li class="mb-3"><i class="fas fa-shield-alt me-2"></i> Secure Admin Authentication</li>
                            <li class="mb-3"><i class="fas fa-users-cog me-2"></i> Manage Users & Roles</li>
                            <li class="mb-3"><i class="fas fa-chart-line me-2"></i> View System Analytics</li>
                            <li class="mb-3"><i class="fas fa-database me-2"></i> Database Monitoring</li>
                            <li class="mb-3"><i class="fas fa-cogs me-2"></i> Full System Control</li>
                        </ul>

                        <div class="security-note mt-4">
                            <p class="small">
                                <i class="fas fa-lock me-2"></i>
                                Admin access is protected with enterprise-level security.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Right Side - Admin Login Form -->
                <div class="col-lg-6 bg-white p-5">
                    <div class="form-container">
                        <div class="form-header text-center mb-4">
                            <h3 class="fw-bold">Admin Login</h3>
                            <p class="text-muted small">
                                Enter your admin credentials to access dashboard
                            </p>
                        </div>

                    <form asp-controller="Resgistration" asp-action="AdminLogin" method="post">

                            <!-- Email -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Admin Email</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white">
                                        <i class="fas fa-envelope"></i>
                                    </span>
                                    <input type="email" name="email" class="form-control"
                                           placeholder="admin@example.com" required>
                                </div>
                            </div>

                            <!-- Password -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Password</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white">
                                        <i class="fas fa-lock"></i>
                                    </span>
                                    <input type="password" name="password" class="form-control"
                                           placeholder="Enter admin password" required>
                                </div>
                            </div>

                            <!-- Remember & Forgot -->
                            <div class="d-flex justify-content-between mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="rememberAdmin">
                                    <label class="form-check-label small" for="rememberAdmin">
                                        Remember me
                                    </label>
                                </div>
                                <a href="#" class="small text-decoration-none">
                                    Forgot Password?
                                </a>
                            </div>

                            <!-- Login Button -->
                            <div class="d-grid mb-3">
                                <button type="submit" class="btn btn-dark">
                                    <i class="fas fa-sign-in-alt me-2"></i> Login to Admin Panel
                                </button>
                            </div>

                            <!-- Back to Website -->
                            <div class="text-center">
                                <p class="small text-muted">
                                    Not an admin?
                                    <a href="/" class="text-decoration-none fw-semibold">
                                        Return to Website
                                    </a>
                                </p>
                            </div>

                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
}
